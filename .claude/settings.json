{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-doc-gate.mjs",
            "timeout": 30,
            "statusMessage": "Checking doc freshness"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "tanstack-all@tanstack-skills": true,
    "gsap-skills@gsap-skills": true
  }
}
