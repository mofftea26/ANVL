# Cloudflare Workers Assets header rules (also honored by Pages).
# Copied verbatim into dist/client/ by Vite, then applied by the Assets binding
# to statically-served files — these responses never pass through the SSR
# Worker, so their headers must be set here (SSR/dynamic headers live in
# src/start.ts).

# Fingerprinted build output — filenames are content-hashed, so a changed file
# is always a new URL. Safe to cache forever and never revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
