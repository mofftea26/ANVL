{
  "include": ["**/*.ts", "**/*.tsx"],
  // worker-configuration.d.ts (generated by `pnpm cf-typegen`) declares the
  // Cloudflare Workers runtime globals, whose HTMLRewriter `Element` merges
  // into and conflicts with the DOM lib `Element` (e.g. `removeAttribute`
  // returns `Element` instead of `void`). The app is DOM-centric and uses no
  // Worker bindings, so exclude it from the storefront typecheck. Re-include
  // it in a Worker-scoped tsconfig if/when `Env` bindings are added.
  "exclude": ["supabase/functions/**", "worker-configuration.d.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
