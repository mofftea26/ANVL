# --- Supabase (public — safe in Vite / browser) ---
# Dashboard → Project Settings → API Keys → Publishable key (or Legacy anon JWT)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback when publishable key is unset:
# VITE_SUPABASE_ANON_KEY=

# --- Local-only fallback when Supabase env above is unset ---
# VITE_ANVL_ADMIN_USER=
# VITE_ANVL_ADMIN_PASSWORD=

# --- Server-only / Edge (never VITE_*) ---
# ANVL_MEDUSA_WEBHOOK_SECRET=
