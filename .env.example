# --- Supabase (public — safe in Vite / browser) ---
# Dashboard → Project Settings → API Keys → Publishable key (or Legacy anon JWT)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback when publishable key is unset:
# VITE_SUPABASE_ANON_KEY=

# --- Server-only / CI / Edge (never VITE_* — never import into client bundles) ---
# Used for migrations, bootstrap scripts, and privileged writes outside RLS.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Admin session (server-only — never VITE_*) ---
# Seals/signs the HttpOnly admin session cookie (src/features/admin/auth/adminAuthSession.server.ts).
# Required for /admin login. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters. Rotating it invalidates all active admin sessions.
# ANVL_ADMIN_SESSION_SECRET=

# --- Shopify headless commerce (Storefront API — safe in browser) ---
# When set, catalog/cart/checkout use Shopify; CMS still owns drops + layout in Supabase.
# VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# VITE_SHOPIFY_STOREFRONT_API_VERSION=2025-01
# VITE_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# --- Server-only / Edge (never VITE_*) ---
# SHOPIFY_ADMIN_API_ACCESS_TOKEN=
# SHOPIFY_API_SECRET_KEY=

# Legacy stub (replaced by shopify-webhook when using Shopify):
# ANVL_MEDUSA_WEBHOOK_SECRET=
