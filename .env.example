# ANVL local CMS admin gate (Vite)
#
# !!! WARNING — these values are inlined into the public JS bundle by Vite.
# !!! NEVER set a real, reusable, or production-shaped password here.
# !!! The admin gate is a documented temporary local-only stand-in until a
# !!! real auth provider lands (see docs/technical-debt.md SEC-01/02/03
# !!! and docs/audit-2026-05-17.md Phase J1).
#
# Pick a long random string you only use for this local demo, e.g.:
#   openssl rand -base64 24
#
VITE_ANVL_ADMIN_USERNAME=admin
VITE_ANVL_ADMIN_PASSWORD=changeme-please-set-a-strong-local-password
