# --- Public (safe in Vite / browser) ---
# Supabase project URL + anon (or publishable) key — enables SSR + CSR reads of
# `storefront_publication` (drop, layout, site SEO, catalog snapshot, global brand, campaigns, lookbook).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
# Alias also supported — see src/features/cms/api/supabasePublicEnv.ts
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Temporary static admin gate — used only when VITE_SUPABASE_URL / anon key are **not** set.
# When Supabase is configured, /admin uses Supabase Auth + cms_profiles.role = admin.
# VITE_ANVL_ADMIN_USER=
# VITE_ANVL_ADMIN_PASSWORD=

# --- Server-only / CI / Edge (never VITE_* — never import into client bundles) ---
# Used for migrations, bootstrap scripts, and privileged writes outside RLS.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Shopify headless commerce (Storefront API — safe in browser) ---
# When set, catalog/cart/checkout use Shopify; CMS still owns drops + layout in Supabase.
# VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# VITE_SHOPIFY_STOREFRONT_API_VERSION=2025-01
# VITE_SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# --- Server-only / Edge (never VITE_*) ---
# SHOPIFY_ADMIN_API_ACCESS_TOKEN=
# SHOPIFY_API_SECRET_KEY=

# Legacy stub (replaced by shopify-webhook when using Shopify):
# ANVL_MEDUSA_WEBHOOK_SECRET=
