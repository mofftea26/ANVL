{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name — matches the Worker provisioned by Cloudflare's Git
  // integration (derived from the repo). Keep in sync with the dashboard
  // Worker where the environment variables/secrets are set.
  "name": "anvl",
  // Pin the Workers runtime behavior. Bump deliberately; a newer date can
  // change built-in API semantics.
  "compatibility_date": "2026-07-11",
  // Required by this project: the SSR entry reads server secrets at request
  // time via `process.env` (admin session secret, NODE_ENV) and TanStack
  // Start's server runtime expects Node built-ins. Without this flag those
  // reads fail on workerd.
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start's Workers SSR entry. The @cloudflare/vite-plugin wires the
  // built client assets automatically, so no explicit `assets` block is
  // needed here.
  "main": "@tanstack/react-start/server-entry",
  // Turn on runtime logs/metrics in the Cloudflare dashboard.
  "observability": {
    "enabled": true
  },
  // Smart Placement runs the SSR Worker near the Supabase origin instead of
  // near each visitor, cutting the latency of the several Supabase round-trips
  // the storefront projection load makes per request.
  "placement": {
    "mode": "smart"
  },
  // Rate limiting for the two unauthenticated surfaces that had none (F-07).
  // These bindings exist only on a deployed Worker; `src/rateLimit.server.ts`
  // FAILS OPEN when they are absent, so local dev and any deploy that predates
  // them behave exactly as before rather than refusing traffic.
  //
  // `namespace_id` is an arbitrary but STABLE per-limiter id — changing one
  // resets its counters. `period` accepts only 10 or 60 (seconds).
  // Limits are deliberately generous: they stop scripted abuse without ever
  // getting in a real operator's way (a human cannot mistype a password 20
  // times in a minute).
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "CSP_REPORT_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Runtime (non-secret) vars. NODE_ENV must be "production" on the deployed
  // Worker — Cloudflare does not set it automatically, and the admin session +
  // CSRF cookies gate their `Secure` attribute (and HSTS) on it. Secrets
  // (ANVL_ADMIN_SESSION_SECRET) are set with `wrangler secret put`, never here.
  "vars": {
    "NODE_ENV": "production"
  }
}
