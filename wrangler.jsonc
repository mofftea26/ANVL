{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anvl-athletics",
  // Pin the Workers runtime behavior. Bump deliberately; a newer date can
  // change built-in API semantics.
  "compatibility_date": "2025-09-02",
  // Required by this project: the SSR entry reads server secrets at request
  // time via `process.env` (admin session secret, NODE_ENV) and TanStack
  // Start's server runtime expects Node built-ins. Without this flag those
  // reads fail on workerd.
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start's Workers SSR entry. The @cloudflare/vite-plugin wires the
  // built client assets automatically, so no explicit `assets` block is
  // needed here.
  "main": "@tanstack/react-start/server-entry",
  // Turn on runtime logs/metrics in the Cloudflare dashboard.
  "observability": {
    "enabled": true
  },
  // Runtime (non-secret) vars. NODE_ENV must be "production" on the deployed
  // Worker — Cloudflare does not set it automatically, and the admin session +
  // CSRF cookies gate their `Secure` attribute (and HSTS) on it. Secrets
  // (ANVL_ADMIN_SESSION_SECRET) are set with `wrangler secret put`, never here.
  "vars": {
    "NODE_ENV": "production"
  }
}
