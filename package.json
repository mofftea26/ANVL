{
  "name": "anvl-store",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "publishConfig": {
    "types": "dist-ui/types/shared/components/ui/index.d.ts"
  },
  "scripts": {
    "dev": "node scripts/repatch-admin-route-tree.mjs && vite dev --port 3000",
    "build": "vite build && node scripts/repatch-admin-route-tree.mjs",
    "preview": "vite preview",
    "analyze": "ANVL_ANALYZE=1 vite build && node scripts/repatch-admin-route-tree.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:related": "vitest run --changed",
    "typecheck": "node scripts/repatch-admin-route-tree.mjs && tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:check": "node scripts/check-docs-freshness.mjs --working",
    "hooks:install": "git config core.hooksPath .githooks",
    "strip-brand-bg": "node scripts/strip-brand-logo-bg.mjs",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.7",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.64",
    "@tanstack/react-virtual": "^3.13.24",
    "@tanstack/router-plugin": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "pdfjs-dist": "6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.74.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.171.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@storybook/react-vite": "^10.4.6",
    "@tanstack/devtools-vite": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^28.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "storybook": "^10.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.110.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
